opam-version: "2.0"
name: "paxos"
version: "dev"
synopsis: "Learning paxos algo(s) using ocaml."
description:
  "A summary exercise at the end of a head-first dive into learning ocaml, this package just has some learning examples"
maintainer: "Ritesh Kumar <hello@rtshkmr.com>"
authors: "Ritesh Kumar <hello@rtshkmr.com>"
license: "GPL-3.0-only"
tags: ["distributed" "consensus" "ocaml" "paxos" "learning"]
homepage: "https://github.com/rtshkmr/paxos_ocaml_demo"
bug-reports: "https://github.com/rtshkmr/paxos_ocaml_demo/issues"
depends: [
  "astring" {= "0.8.5"}
  "base" {= "v0.17.3"}
  "base-bigarray" {= "base"}
  "base-bytes" {= "base"}
  "base-domains" {= "base"}
  "base-effects" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "base_bigstring" {= "v0.17.0"}
  "base_quickcheck" {= "v0.17.1"}
  "bin_prot" {= "v0.17.0-1"}
  "camlp-streams" {= "5.0.1"}
  "capitalization" {= "v0.17.0"}
  "chrome-trace" {= "3.20.2"}
  "cmdliner" {= "2.1.0"}
  "core" {= "v0.17.1"}
  "core_kernel" {= "v0.17.0"}
  "core_unix" {= "v0.17.1"}
  "cppo" {= "1.8.0"}
  "crunch" {= "4.0.0" & with-doc}
  "csexp" {= "1.5.2"}
  "dot-merlin-reader" {= "5.6-504"}
  "dune" {= "3.20.2"}
  "dune-build-info" {= "3.20.2"}
  "dune-configurator" {= "3.20.2"}
  "dune-rpc" {= "3.20.2"}
  "dyn" {= "3.20.2"}
  "either" {= "1.0.0"}
  "expect_test_helpers_core" {= "v0.17.0"}
  "fiber" {= "3.7.0"}
  "fieldslib" {= "v0.17.0"}
  "fix" {= "20250919"}
  "fmt" {= "0.11.0"}
  "fpath" {= "0.7.3"}
  "gel" {= "v0.17.0"}
  "int_repr" {= "v0.17.0"}
  "jane-street-headers" {= "v0.17.0"}
  "jsonrpc" {= "1.24.0"}
  "jst-config" {= "v0.17.0"}
  "lambda-term" {= "3.3.2"}
  "logs" {= "0.10.0"}
  "lsp" {= "1.24.0"}
  "lwt" {= "5.9.2"}
  "lwt_react" {= "1.2.0"}
  "menhir" {= "20250912"}
  "menhirCST" {= "20250912"}
  "menhirLib" {= "20250912"}
  "menhirSdk" {= "20250912"}
  "merlin" {= "5.6-504"}
  "merlin-lib" {= "5.6-504"}
  "mew" {= "0.1.0"}
  "mew_vi" {= "0.5.0"}
  "num" {= "1.6"}
  "ocaml" {= "5.4.0"}
  "ocaml-base-compiler" {= "5.4.0"}
  "ocaml-compiler" {= "5.4.0"}
  "ocaml-compiler-libs" {= "v0.17.0"}
  "ocaml-config" {= "3"}
  "ocaml-index" {= "5.6-504"}
  "ocaml-lsp-server" {= "1.24.0"}
  "ocaml-options-vanilla" {= "1"}
  "ocaml-version" {= "4.0.3"}
  "ocaml_intrinsics_kernel" {= "v0.17.1"}
  "ocamlbuild" {= "0.16.1"}
  "ocamlc-loc" {= "3.20.2"}
  "ocamlfind" {= "1.9.8"}
  "ocamlformat" {= "0.28.1"}
  "ocamlformat-lib" {= "0.28.1"}
  "ocamlformat-rpc-lib" {= "0.28.1"}
  "ocp-indent" {= "1.9.0"}
  "ocplib-endian" {= "1.2"}
  "odoc" {= "3.1.0" & with-doc}
  "odoc-parser" {= "3.1.0" & with-doc}
  "ordering" {= "3.20.2"}
  "parsexp" {= "v0.17.0"}
  "pp" {= "2.0.0"}
  "ppx_assert" {= "v0.17.0"}
  "ppx_base" {= "v0.17.0"}
  "ppx_bench" {= "v0.17.1"}
  "ppx_bin_prot" {= "v0.17.1"}
  "ppx_cold" {= "v0.17.0"}
  "ppx_compare" {= "v0.17.0"}
  "ppx_custom_printf" {= "v0.17.0"}
  "ppx_derivers" {= "1.2.1"}
  "ppx_deriving" {= "6.1.1"}
  "ppx_deriving_yojson" {= "3.10.0"}
  "ppx_diff" {= "v0.17.1"}
  "ppx_disable_unused_warnings" {= "v0.17.0"}
  "ppx_enumerate" {= "v0.17.0"}
  "ppx_expect" {= "v0.17.3"}
  "ppx_fields_conv" {= "v0.17.0"}
  "ppx_fixed_literal" {= "v0.17.0"}
  "ppx_globalize" {= "v0.17.2"}
  "ppx_hash" {= "v0.17.0"}
  "ppx_here" {= "v0.17.0"}
  "ppx_ignore_instrumentation" {= "v0.17.0"}
  "ppx_inline_test" {= "v0.17.1"}
  "ppx_jane" {= "v0.17.0"}
  "ppx_let" {= "v0.17.1"}
  "ppx_log" {= "v0.17.0"}
  "ppx_module_timer" {= "v0.17.0"}
  "ppx_optcomp" {= "v0.17.1"}
  "ppx_optional" {= "v0.17.0"}
  "ppx_pipebang" {= "v0.17.0"}
  "ppx_sexp_conv" {= "v0.17.1"}
  "ppx_sexp_message" {= "v0.17.0"}
  "ppx_sexp_value" {= "v0.17.0"}
  "ppx_stable" {= "v0.17.1"}
  "ppx_stable_witness" {= "v0.17.0"}
  "ppx_string" {= "v0.17.0"}
  "ppx_string_conv" {= "v0.17.0"}
  "ppx_tydi" {= "v0.17.1"}
  "ppx_typerep_conv" {= "v0.17.1"}
  "ppx_variants_conv" {= "v0.17.1"}
  "ppx_yojson_conv_lib" {= "v0.17.0"}
  "ppxlib" {= "0.37.0"}
  "ppxlib_jane" {= "v0.17.4"}
  "ptime" {= "1.2.0" & with-doc}
  "re" {= "1.14.0"}
  "react" {= "1.2.2"}
  "result" {= "1.5"}
  "seq" {= "base" & with-doc}
  "sexp_pretty" {= "v0.17.0"}
  "sexplib" {= "v0.17.0"}
  "sexplib0" {= "v0.17.0"}
  "spawn" {= "v0.17.0"}
  "splittable_random" {= "v0.17.0"}
  "stdio" {= "v0.17.0"}
  "stdlib-shims" {= "0.3.0"}
  "stdune" {= "3.20.2"}
  "time_now" {= "v0.17.0"}
  "timezone" {= "v0.17.0"}
  "topkg" {= "1.1.1"}
  "trie" {= "1.0.0"}
  "typerep" {= "v0.17.1"}
  "tyxml" {= "4.6.0" & with-doc}
  "uchar" {= "0.0.2"}
  "uopt" {= "v0.17.0"}
  "utop" {= "2.16.0"}
  "uucp" {= "17.0.0"}
  "uuseg" {= "17.0.0"}
  "uutf" {= "1.0.4"}
  "variantslib" {= "v0.17.0"}
  "xdg" {= "3.20.2"}
  "yojson" {= "3.0.0"}
  "zed" {= "3.2.3"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/rtshkmr/paxos_ocaml_demo.git"
x-maintenance-intent: ["(latest)"]