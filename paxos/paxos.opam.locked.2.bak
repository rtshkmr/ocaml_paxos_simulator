opam-version: "2.0"
name: "paxos"
version: "dev"
synopsis: "Learning paxos algo(s) using ocaml."
description:
  "A summary exercise at the end of a head-first dive into learning ocaml, this package just has some learning examples."
maintainer: "Ritesh Kumar <hello@rtshkmr.com>"
authors: "Ritesh Kumar <hello@rtshkmr.com>"
license: "GPL-3.0-only"
tags: ["add topics" "to describe" "your" "project"]
homepage: "https://github.com/rtshkmr/paxos_ocaml_demo"
bug-reports: "https://github.com/rtshkmr/paxos_ocaml_demo/issues"
depends: [
  "astring" {= "0.8.5" & with-doc}
  "base" {= "v0.17.3"}
  "base-bigarray" {= "base"}
  "base-domains" {= "base"}
  "base-effects" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "camlp-streams" {= "5.0.1" & with-doc}
  "cmdliner" {= "2.1.0" & with-doc}
  "cppo" {= "1.8.0" & with-doc}
  "crunch" {= "4.0.0" & with-doc}
  "csexp" {= "1.5.2"}
  "dune" {= "3.20.2"}
  "dune-configurator" {= "3.20.2"}
  "fmt" {= "0.11.0" & with-doc}
  "fpath" {= "0.7.3" & with-doc}
  "ocaml" {= "5.4.0"}
  "ocaml-base-compiler" {= "5.4.0"}
  "ocaml-compiler" {= "5.4.0"}
  "ocaml-config" {= "3"}
  "ocaml-options-vanilla" {= "1"}
  "ocaml_intrinsics_kernel" {= "v0.17.1"}
  "ocamlbuild" {= "0.16.1" & with-doc}
  "ocamlfind" {= "1.9.8" & with-doc}
  "odoc" {= "3.1.0" & with-doc}
  "odoc-parser" {= "3.1.0" & with-doc}
  "ptime" {= "1.2.0" & with-doc}
  "re" {= "1.14.0" & with-doc}
  "seq" {= "base" & with-doc}
  "sexplib0" {= "v0.17.0"}
  "topkg" {= "1.1.1" & with-doc}
  "tyxml" {= "4.6.0" & with-doc}
  "uutf" {= "1.0.4" & with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/rtshkmr/paxos_ocaml_demo.git"
x-maintenance-intent: ["(latest)"]