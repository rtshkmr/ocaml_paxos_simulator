      "locked": false,
      "text": "problem: if this is supposed\nto be a functor that\ngenerates in-memory\nstorage entity, then it\nshould be receiving all the\nmodules that it depends on",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
