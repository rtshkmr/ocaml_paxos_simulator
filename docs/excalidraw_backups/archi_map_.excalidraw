      "text": "Interface: Node_state",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "j1aZR_O8aFiWbn3hfM1lQ",
      "originalText": "Interface: Node_state",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "58ks82V58kTnYw9TDu73T",
      "type": "text",
      "x": -4565.76583052222,
      "y": -3403.329947451505,
      "width": 391.24399966417445,
      "height": 231.7656854688359,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
