      "boundElements": [],
      "updated": 1763108148396,
      "link": null,
      "locked": false,
      "text": "problem: why is acceptor_state special\nand separate? why can't it be just a\nrecord type??\n\n- it doesn't need to be a module\n\n- it can be local to the node_state",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "KXVgLYP11T4Vbx1Zyk3IM",
      "originalText": "problem: why is acceptor_state special and separate? why can't it be just a record type??\n\n- it doesn't need to be a module\n\n- it can be local to the node_state",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
