      "link": null,
      "locked": false,
      "text": "[state]  \n  type registries =\n    { partition_registry: (Partition.partition_id, Partition.partition) Hashtbl.t\n    ; node_registry: (Types.node_id, NodeImpl.t) Hashtbl.t\n    ; node_alias_registry: (string, NodeImpl.t) Hashtbl.t\n    ; node_to_partition: (Types.node_id, Partition.partition_id) Hashtbl.t }\n\n  type counters =\n    { event_id_counter: Counter.t\n    ; msg_id_counter: Counter.t\n    ; node_id_counter: Counter.t }\n\n  type settings =\n    {max_ticks: int option; deterministic_seed: int option; log_jsonl: bool}\n\n  type t =\n    { mutable halted: bool\n    ; mutable clock: Time.clock\n    ; registries: registries\n    ; scheduler: Event_scheduler.t ref\n    ; event_callbacks: (Sim_event.t -> unit) list ref\n    ; counters: counters\n    ; settings: settings }\n\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[state]  \n  type registries =\n    { partition_registry: (Partition.partition_id, Partition.partition) Hashtbl.t\n    ; node_registry: (Types.node_id, NodeImpl.t) Hashtbl.t\n    ; node_alias_registry: (string, NodeImpl.t) Hashtbl.t\n    ; node_to_partition: (Types.node_id, Partition.partition_id) Hashtbl.t }\n\n  type counters =\n    { event_id_counter: Counter.t\n    ; msg_id_counter: Counter.t\n    ; node_id_counter: Counter.t }\n\n  type settings =\n    {max_ticks: int option; deterministic_seed: int option; log_jsonl: bool}\n\n  type t =\n    { mutable halted: bool\n    ; mutable clock: Time.clock\n    ; registries: registries\n    ; scheduler: Event_scheduler.t ref\n    ; event_callbacks: (Sim_event.t -> unit) list ref\n    ; counters: counters\n    ; settings: settings }\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
