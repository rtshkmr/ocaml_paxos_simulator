      "versionNonce": 1982724396,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763383997078,
      "link": null,
      "locked": false,
      "text": "[purpose]\n1. Simulation helper to group together modules that\ncan communicate with each other via a bus. \n\n2. Will contain event buses that are independent of\nother partitions\n\n3. Should be seen as a stateful container (set)",
      "fontSize": 16.855686215915338,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[purpose]\n1. Simulation helper to group together modules that can communicate with each other via a bus. \n\n2. Will contain event buses that are independent of other partitions\n\n3. Should be seen as a stateful container (set)",
      "autoResize": false,
      "lineHeight": 1.25
