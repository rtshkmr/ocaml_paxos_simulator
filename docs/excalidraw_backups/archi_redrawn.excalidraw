    {
      "id": "Aiyi8uhlIkBhiQhMyf79K",
      "type": "text",
      "x": 7191.817297286622,
      "y": 547.2736589883792,
      "width": 429.23333740234375,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
