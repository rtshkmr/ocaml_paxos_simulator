    },
    {
      "id": "h-xnU6L8G6aUDmM7WY-EI",
      "type": "text",
      "x": 6810.142895973374,
      "y": 570.3172996368744,
      "width": 300.70001220703125,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
