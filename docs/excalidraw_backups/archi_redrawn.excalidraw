      "version": 6560,
      "versionNonce": 262469440,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1763110071655,
      "link": null,
      "locked": false,
      "text": "[DECISION] \n\n1. acceptor record shall just be a record type that we\ndefine within Node_state\n\n2. this means that the Make_node_state functor just\nneeds to take in Value as the module param",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "rzXztGuJuYqGfrAwPH0e5",
      "originalText": "[DECISION] \n\n1. acceptor record shall just be a record type that we define within Node_state\n\n2. this means that the Make_node_state functor just needs to take in Value as the module param",
      "autoResize": true,
      "lineHeight": 1.25
    },
